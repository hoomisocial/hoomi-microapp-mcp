NODE_ENV=development
HOST=0.0.0.0
PORT=8300
MCP_PATH=/mcp

# Production must use hoomi-session. The secret is the Hoomi API JWT_KEY.
MCP_AUTH_MODE=hoomi-session
HOOMI_JWT_SECRET=replace-with-at-least-32-random-bytes
HOOMI_JWT_ISSUER=HOOMI-API
ALLOW_INSECURE_LOCAL=false

HOOMI_API_BASE_URL=https://apidev.hoomi.social
HOOMI_REQUEST_TIMEOUT_MS=10000
HOOMI_MAX_RESPONSE_BYTES=2000000
MCP_MAX_TOOL_OUTPUT_BYTES=200000
SECRET_HANDOFF_STORE=redis
REDIS_URL=redis://:replace-with-redis-password@redis:6379
REDIS_PASSWORD=replace-with-redis-password
SECRET_HANDOFF_TTL_SECONDS=300
SECRET_HANDOFF_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
SECRET_HANDOFF_PATH=/v1/secret-handoffs
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MCP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
